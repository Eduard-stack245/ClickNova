# Track ClickNova source, build scripts, tests, and required license files only.
# Exclude generated output, documentation, and private user data.

# vcpkg developer dependency checkout; never publish the downloaded toolchain.
/tools/vcpkg/
/tools/clicknova-visual-vcpkg*/
/tools/clicknova-visual-installer.lock

# CMake / IDE build directories (all variants used by ClickNova)
/build/
/build-*/
/cmake-build-*/
/out/
/dist/
/dist-*/
/dist-windows/
/artifacts/
/.cache/
/.qt/

# CMake-generated files accidentally created in the source tree
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
Testing/
_autogen/
*_autogen/

# Visual Studio, VS Code, JetBrains and Qt Creator local metadata
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb
*.vcxproj.user
*.pro.user
*.pro.user.*
CMakeUserPresets.json

# Native binary artifacts (build outputs, not source code)
*.exe
*.dll
*.lib
*.exp
*.obj
*.o
*.a
*.so
*.so.*
*.dylib
*.pdb
*.ilk
*.idb
*.ipch
*.pch
*.tlog
*.lastbuildstate
*.app/

# Generated Qt code
moc_*.cpp
qrc_*.cpp
ui_*.h

# Packages and release staging (created by CI, not stored in Git)
/ClickNova-*.zip
/ClickNova-*.7z
/ClickNova-*.tar.gz
*.msi
*.msix
*.AppImage
*.deb
*.rpm

# Logs, temporary files, crash dumps, system files
*.log
*.tmp
*.bak
*.dmp
*.stackdump
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Local update packages
/patch/
/BASELINE.sha256
/MANIFEST.sha256
/apply-update.cmd
/apply-update.ps1
/README.txt

# Local user profiles and private configuration
/.clicknova/
/user-data/
/user-profiles/
/user-macros/
/.env
/.env.*
!/.env.example

# Language/tool-specific caches used by auxiliary scripts
__pycache__/
.pytest_cache/
*.py[cod]

# Documentation and workflow metadata are excluded from the minimal source repository.
/README.md
/CHANGELOG.md
/CONTRIBUTING.md
/RELEASE_NOTES.md
/docs/
# Keep ONLY the audited, buildable portable release workflow in version control.
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/portable-releases.yml

# Personal scenarios, build output, and logs are never tracked.

# Extra local profile exports and UI settings (not repository assets)
*.clicknova-profile.json
*.clicknova.ini
/user-settings/

# Saved scenario exports and accidental local scenario folders
/scenarios/
/user-scenarios/
*.clicknova-scenario.json

# User autosave drafts and private settings (never stage)
autosave*.json
*autosave*.json
*.clicknova-draft.json
*.clicknova-draft

# Other exported scenarios and user settings
*.clicknova.json
*.clicknova-scenario
*.clicknova-profile
*.clicknova-backup
*.clicknova-session
*.clicknova-settings.json
/local/
/profiles/
/backups/

# Private input recording recovery files (never commit typed content)
*.cnrecord.json
/recording-recovery/

# ClickNova portable user data and installed OCR language models
data/

# Strict pre-commit hygiene: local backups and application-generated assets.
# Source updates create backup-... folders at the project root; NEVER commit them.
/backup-*/
/backup_*/
/ClickNova-data/
/tessdata/
/recording-recovery/
*.traineddata
*.sqlite
*.sqlite3

# Project audit notes and release documentation stay out of the minimal source repo.
/*.md
